     return path.substr(0, dot);
 }
 
+// 只取文件名部分（去掉前面的目录路径）
+static path_t get_file_name(const path_t& path)
+{
+    size_t slash = path.find_last_of(PATHSTR("/\\"));
+    if (slash == path_t::npos)
+        return path;
+
+    return path.substr(slash + 1);
+}
